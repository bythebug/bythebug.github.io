---
const featured = [
  {
    number: '01',
    title: 'Distributed Log Processor',
    category: 'Systems · Scale',
    year: '2024',
    description:
      'Processes 500K+ log events/second. Kafka for ingest, consumer groups for horizontal scale, Redis for deduplication state. Built to understand where production log pipelines fail under real throughput.',
    tags: ['Python', 'Kafka', 'Redis', 'Distributed'],
    stars: 0,
    url: 'https://github.com/bythebug/Real-Time-Distributed-Log-Processing-System',
  },
  {
    number: '02',
    title: 'AI Image Detector',
    category: 'AI · Privacy',
    year: '2024',
    description:
      'Runs entirely in the browser: EXIF/XMP metadata extraction plus C2PA/JUMBF provenance chain verification, no server hop, no data retention. The zero-server constraint shaped the entire architecture.',
    tags: ['JavaScript', 'C2PA', 'Privacy'],
    stars: 6,
    url: 'https://github.com/bythebug/AI-Image-Detector',
  },
  {
    number: '03',
    title: 'context-os',
    category: 'AI · Infrastructure',
    year: '2024',
    description:
      'Memory layer for LLM applications: clients write a session summary after each conversation, read it before the next. Model-agnostic by design; the interface doesn\'t care whether the backend is GPT-4 or Llama.',
    tags: ['Python', 'LLM', 'Infrastructure'],
    stars: 1,
    url: 'https://github.com/bythebug/context-os',
  },
];
---

<section class="section" id="work">
  <div class="container">

    <div class="projects-header reveal">
      <span class="label">Featured Work</span>
      <a href="/projects" class="label view-all">All projects ↗</a>
    </div>
    <hr class="rule" />

    {featured.map((p, i) => (
      <div class="project-item reveal" style={`transition-delay: ${i * 0.07}s`}>
        <div class="project-inner">
          <div class="project-num">
            <span class="label">{p.number}</span>
          </div>
          <div class="project-content">
            <div class="project-header">
              <h3 class="project-title">
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.title}
                  {p.stars > 0 && (
                    <span class="stars">★ {p.stars}</span>
                  )}
                  <svg class="arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M4.5 13.5L13.5 4.5M13.5 4.5H7.5M13.5 4.5V10.5"
                      stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </h3>
              <div class="project-meta">
                <span class="label">{p.category}</span>
                <span class="sep">·</span>
                <span class="label">{p.year}</span>
              </div>
            </div>
            <p class="project-desc">{p.description}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
        <hr class="rule" />
      </div>
    ))}

    <div class="projects-footer reveal">
      <a href="/projects" class="all-link">
        View all projects
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .projects-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
  }

  .view-all {
    transition: color 0.2s;
  }
  .view-all:hover { color: var(--text); }

  .project-item {
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .project-inner {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .project-num {
    padding-top: 0.25rem;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.85rem;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3vw, 1.75rem);
    font-weight: 500;
    font-optical-sizing: auto;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .project-title a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: color 0.2s;
  }

  .project-title a:hover { color: var(--accent); }

  .stars {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
    letter-spacing: 0;
  }

  .arrow {
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.2s, transform 0.25s var(--ease-out);
    flex-shrink: 0;
  }

  .project-title a:hover .arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    padding-top: 0.3rem;
  }

  .sep {
    color: var(--border);
    font-size: 0.85rem;
  }

  .project-desc {
    font-size: 0.93rem;
    color: var(--text-muted);
    line-height: 1.68;
    max-width: 62ch;
    margin-bottom: 1.1rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ─── Footer CTA ─── */
  .projects-footer {
    padding-top: 2rem;
    display: flex;
    justify-content: flex-end;
  }

  .all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: color 0.2s;
  }
  .all-link:hover { color: var(--accent); }
  .all-link svg { transition: transform 0.25s var(--ease-out); }
  .all-link:hover svg { transform: translateX(4px); }

  @media (max-width: 600px) {
    .project-inner {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .project-header {
      flex-direction: column;
    }
  }
</style>
