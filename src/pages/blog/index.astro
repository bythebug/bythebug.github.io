---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="Blog — Suraj Verma"
  description="Writing on software engineering, AI/ML, and building in public."
>
  <Nav currentPage="home" />

  <main class="main">
    <div class="container">

      <div class="page-header">
        <h1 class="page-title">Blog</h1>
      </div>

      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="post-link">
              <span class="post-title">{post.data.title}</span>
              <span class="post-meta">
                <span class="post-date">{post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
                <span class="post-arrow">↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </main>
</Layout>

<style>
  .main {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .page-header {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    font-optical-sizing: auto;
    letter-spacing: -0.045em;
    line-height: 0.88;
  }

  /* ─── Post list ─── */
  .post-list {
    list-style: disc;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .post-list li::marker {
    color: var(--accent);
  }

  .post-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.015em;
    transition: color 0.15s;
  }

  .post-link:hover { color: var(--accent); }

  .post-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 400;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }

  .post-link:hover .post-date { color: var(--text-muted); }

  .post-arrow {
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: color 0.15s, transform 0.15s;
  }

  .post-link:hover .post-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
</style>
