---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const spotifyAlbum = { id: '1pWVWJ1w0dQbNxxlv5SYR4', title: 'Seher Ki Raat', year: '2025' };

const spotifyTracks: { id: string; title: string }[] = [
  { id: '4LkxisFHSq67DVo2gkmMrB', title: 'Pehli Baar Tum'    },
  { id: '0S6e31XW0xPG3t8XucB3rh', title: 'Tere Bina Bhi'    },
  { id: '0ZGOgfnEld3CkZVOM0Dmvc', title: 'Seher Ki Raat'     },
  { id: '2wAZZJC8nz0tAY88aNsb9A', title: 'Phir Se Chal Pade' },
  { id: '2drlftGsYUyRb9cBHgGNNO', title: 'Raat Bhar'         },
];

const youtubeIds: string[] = [
  'n6sPWr213fI',  // MITACS GRI 2027: The Only Video You Need
  'aVEylJLff5Y',  // Pehli Baar Tum | Seher Ki Raat
  'BwlQJFNccrs',  // 2 years later. A fresh start.
  'eP0Kbfj4n9I',  // first snow in canada
  '_BqB29iSllw',  // making a music video in 24 hours
  '_-NEin1bXIk',  // inside google india | graduation day 2023
  'Sv1QR55SDxc',  // toronto to montreal to edmonton
  'heiAZHKileQ',  // a day in my life as a research intern
];

const ytTitles: Record<string, string> = {
  'n6sPWr213fI': 'MITACS GRI 2027: The Only Video You Need',
  'aVEylJLff5Y': 'Pehli Baar Tum | Seher Ki Raat',
  'BwlQJFNccrs': '2 years later. A fresh start.',
  'eP0Kbfj4n9I': 'first snow in canada',
  '_BqB29iSllw': 'making a music video in 24 hours',
  '_-NEin1bXIk': 'inside google india | graduation day 2023',
  'Sv1QR55SDxc': 'toronto to montreal to edmonton',
  'heiAZHKileQ': 'a day in my life as a research intern',
};

const videoListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'bythebug YouTube Videos',
  itemListElement: youtubeIds.map((id, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'VideoObject',
      name: ytTitles[id],
      url: `https://youtu.be/${id}`,
      thumbnailUrl: `https://img.youtube.com/vi/${id}/maxresdefault.jpg`,
      uploadDate: '2024-01-01',
      author: { '@type': 'Person', name: 'Suraj Van Verma', url: 'https://youtube.com/@bythebug' },
    },
  })),
};
---

<Layout title="Archive — Suraj Van Verma" description="Videos, posts, and content from across the internet.">
  <script type="application/ld+json" set:html={JSON.stringify(videoListLd)} />
  <Nav currentPage="home" />

  <main class="main">
    <div class="container">

      <div class="page-header">
        <h1 class="page-title">Creator Archive</h1>
      </div>

      <!-- Platform links -->
      <div class="platform-links">
        <a href="https://youtube.com/@bythebug" target="_blank" rel="noopener noreferrer" class="platform-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="#FF0000"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          YouTube
        </a>
        <a href="https://instagram.com/suraj.builds" target="_blank" rel="noopener noreferrer" class="platform-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="url(#ig-grad)">
            <defs><linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="50%" stop-color="#dc2743"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs>
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          Instagram
        </a>
        <a href="https://linkedin.com/in/bythebug" target="_blank" rel="noopener noreferrer" class="platform-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="#0A66C2"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href="https://open.spotify.com/artist/4McD3qf6GvaBvpX7J39B4o" target="_blank" rel="noopener noreferrer" class="platform-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="#1DB954"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          Spotify
        </a>
      </div>

      <!-- Spotify -->
      <section class="section-block">
        <div class="section-label">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="#1DB954"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          Spotify
        </div>
        <div class="sp-album">
          <a
            href={`https://open.spotify.com/album/${spotifyAlbum.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="sp-album-art"
          >
            <img src="/spotify/album.jpg" alt={spotifyAlbum.title} loading="lazy" />
            <div class="sp-play">
              <svg viewBox="0 0 24 24" width="40" height="40">
                <circle cx="12" cy="12" r="12" fill="#1DB954"/>
                <path d="M9.5 7.5l7 4.5-7 4.5V7.5z" fill="#fff"/>
              </svg>
            </div>
          </a>
          <div class="sp-album-info">
            <a
              href={`https://open.spotify.com/album/${spotifyAlbum.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-album-title"
            >
              {spotifyAlbum.title}
            </a>
            <span class="sp-album-sub">Album · {spotifyAlbum.year}</span>
            <ol class="sp-tracklist">
              {spotifyTracks.map((track, i) => (
                <li>
                  <a href={`https://open.spotify.com/track/${track.id}`} target="_blank" rel="noopener noreferrer">
                    <span class="sp-track-num">{i + 1}</span>
                    {track.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- YouTube -->
      <section class="section-block">
        <div class="section-label">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="#FF0000"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          YouTube
        </div>
        <div class="yt-featured">
          <a
            href={`https://youtu.be/${youtubeIds[0]}`}
            target="_blank"
            rel="noopener noreferrer"
            class="yt-featured-thumb"
          >
            <img
              src={`https://img.youtube.com/vi/${youtubeIds[0]}/maxresdefault.jpg`}
              alt={ytTitles[youtubeIds[0]]}
              loading="lazy"
            />
            <div class="yt-play">
              <svg viewBox="0 0 68 48" width="56" height="40">
                <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C0 13.05 0 24 0 24s0 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C68 34.95 68 24 68 24s0-10.95-1.48-16.26z" fill="#f00"/>
                <path d="M45 24 27 14v20" fill="#fff"/>
              </svg>
            </div>
          </a>
          <div class="yt-featured-info">
            <a
              href={`https://youtu.be/${youtubeIds[0]}`}
              target="_blank"
              rel="noopener noreferrer"
              class="yt-featured-title"
            >
              {ytTitles[youtubeIds[0]]}
            </a>
            <span class="yt-featured-sub">Latest video</span>
            <ol class="yt-list">
              {youtubeIds.slice(1).map((id, i) => (
                <li>
                  <a href={`https://youtu.be/${id}`} target="_blank" rel="noopener noreferrer">
                    <span class="yt-num">{i + 2}</span>
                    {ytTitles[id]}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .main {
    padding-top: 5rem;
    padding-bottom: 8rem;
  }

  .page-header {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    font-optical-sizing: auto;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  /* ─── Section label ─── */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  /* ─── YouTube featured + list ─── */
  .section-block {
    margin-bottom: 3.5rem;
  }

  .yt-featured {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.75rem;
  }

  .yt-featured-thumb {
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .yt-featured-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s;
  }

  .yt-featured-thumb:hover img { opacity: 0.75; }

  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .yt-featured-info {
    display: flex;
    flex-direction: column;
  }

  .yt-featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .yt-featured-title:hover { color: var(--accent); }

  .yt-featured-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
    margin-bottom: 1.25rem;
  }

  .yt-list {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .yt-list li {
    border-top: 1px solid var(--border);
  }

  .yt-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .yt-list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.25rem;
    font-size: 0.88rem;
    color: var(--text);
    transition: color 0.15s;
  }

  .yt-list a:hover { color: var(--accent); }

  .yt-num {
    color: var(--text-muted);
    font-size: 0.78rem;
    width: 1rem;
  }

  /* ─── Spotify album ─── */
  .sp-album {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.75rem;
  }

  .sp-album-art {
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .sp-album-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s;
  }

  .sp-album-art:hover img { opacity: 0.7; }

  .sp-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .sp-album-info {
    display: flex;
    flex-direction: column;
  }

  .sp-album-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .sp-album-title:hover { color: var(--accent); }

  .sp-album-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
    margin-bottom: 1.25rem;
  }

  .sp-tracklist {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sp-tracklist li {
    border-top: 1px solid var(--border);
  }

  .sp-tracklist li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .sp-tracklist a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.25rem;
    font-size: 0.88rem;
    color: var(--text);
    transition: color 0.15s;
  }

  .sp-tracklist a:hover { color: var(--accent); }

  .sp-track-num {
    color: var(--text-muted);
    font-size: 0.78rem;
    width: 1rem;
  }

  /* ─── Platform chips ─── */
  .platform-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .platform-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--text-muted);
    background: var(--bg-alt);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .platform-chip:hover {
    color: var(--text);
    border-color: var(--text-muted);
    background: var(--bg);
  }

  @media (max-width: 900px) {
    .yt-featured { grid-template-columns: 1fr; }
  }

  @media (max-width: 700px) {
    .profiles { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .sp-album { grid-template-columns: 1fr; }
    .sp-album-art { max-width: 220px; }
  }
</style>
